{
  // Schaefer-Turek benchmark 2D-1 (Re = 20): Cd = 5.57953, Cl = 0.010618.
  // Needs Gmsh (PATH or CFD_GMSH). Forces in results/forces.csv.
  "name": "cylinder_2d",
  "mesh": {
    "type": "geometry",
    "min": [0, 0, 0],
    "max": [2.2, 0.41, 0.01],
    "two_d": true,
    "bodies": [{ "type": "cylinder", "base": [0.2, 0.2, 0], "radius": 0.05, "patch": "cylinder" }],
    "size": 0.02,
    "size_near": 0.002,
    "refine_distance": 0.15,
    "boundary_layer": { "layers": 8, "first": 2.5e-4, "ratio": 1.2 },
    "domain_patches": { "xmin": "inlet", "xmax": "outlet", "ymin": "walls", "ymax": "walls",
                        "zmin": "front", "zmax": "back" }
  },
  "physics": { "nu": 1e-3 },
  "boundaries": {
    "inlet": { "type": "velocity_inlet", "velocity": [0.3, 0, 0], "profile": "parabolic", "profile_axes": "y" },
    "outlet": { "type": "pressure_outlet" },
    "front": { "type": "empty" },
    "back": { "type": "empty" }
  },
  "solver": { "max_iterations": 3000, "tolerance": 1e-7, "convection": "limited_linear_upwind",
              "non_orthogonal_correctors": 1 },
  "forces": { "patches": ["cylinder"], "reference_velocity": 0.2, "reference_area": 0.001 },
  "output": { "directory": "results/cylinder_2d", "log_interval": 100 }
}
