{
  // Differentially heated square cavity (de Vahl Davis 1983), Ra = 1e5, Pr = 0.71,
  // non-dimensional: alpha = 1, nu = Pr, g beta dT = Ra Pr. Reference mean Nu = 4.519.
  "name": "heated_cavity",
  "mesh": {
    "type": "box",
    "cells": [64, 64, 1],
    "max": [1, 1, 0.015625],
    "patch_types": { "zmin": "patch", "zmax": "patch" }
  },
  "physics": {
    "nu": 0.71,
    "energy": { "alpha": 1.0, "beta": 1.0, "t_ref": 0.5, "gravity": [0, -71000, 0] }
  },
  "boundaries": {
    "zmin": { "type": "empty" },
    "zmax": { "type": "empty" },
    "xmin": { "thermal": { "type": "fixed", "value": 1.0 } },
    "xmax": { "thermal": { "type": "fixed", "value": 0.0 } }
  },
  "solver": { "max_iterations": 5000, "tolerance": 1e-7, "convection": "limited_linear_upwind" },
  "heat": { "patches": ["xmin", "xmax"], "reference_area": 0.015625 },
  "output": { "directory": "results/heated_cavity", "log_interval": 100 }
}
