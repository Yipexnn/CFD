{
  // Steady flow past a sphere at Re = 100 (D = 1, U = 1, nu = 0.01) on a 3D Gmsh mesh with
  // prism boundary layers. Reference: Cd = 1.09 (Schiller-Naumann 24/Re (1 + 0.15 Re^0.687),
  // Johnson & Patel 1999: 1.087). Least-squares gradients are needed on the tetrahedra
  // (Green-Gauss gives Cd ~1.16). Needs Gmsh. Forces in results/sphere_3d/forces.csv.
  "name": "sphere_3d",
  "mesh": {
    "type": "geometry",
    "min": [-5, -5, -5],
    "max": [15, 5, 5],
    "bodies": [{ "type": "sphere", "centre": [0, 0, 0], "radius": 0.5, "patch": "sphere" }],
    "size": 1.0,
    "size_near": 0.1,
    "refine_distance": 3.0,
    "boundary_layer": { "layers": 6, "first": 0.012, "ratio": 1.25 },
    "domain_patches": { "xmin": "inlet", "xmax": "outlet", "ymin": "farfield", "ymax": "farfield",
                        "zmin": "farfield", "zmax": "farfield" }
  },
  "physics": { "nu": 0.01 },
  "boundaries": {
    "inlet": { "type": "velocity_inlet", "velocity": [1, 0, 0] },
    "outlet": { "type": "pressure_outlet" },
    "farfield": { "type": "symmetry" }
  },
  "initial": { "velocity": [1, 0, 0] },
  "solver": { "max_iterations": 1500, "tolerance": 1e-6, "convection": "limited_linear_upwind", "gradient": "least_squares",
              "non_orthogonal_correctors": 1 },
  "forces": { "patches": ["sphere"], "reference_velocity": 1.0, "reference_area": 0.7853981633974483 },
  "output": { "directory": "results/sphere_3d", "log_interval": 100 }
}
