{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-msvc-mpi-release",
      "displayName": "Windows MSVC Release + MPI (MS-MPI)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CFD_ENABLE_MPI": "ON",
        "VCPKG_MANIFEST_FEATURES": "mpi"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux GCC Debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux GCC Release",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-msvc-gui-dev",
      "displayName": "Windows MSVC RelWithDebInfo + GUI (debuggable)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CFD_BUILD_GUI": "ON",
        "VCPKG_MANIFEST_FEATURES": "gui;mpi",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md-release",
        "VCPKG_HOST_TRIPLET": "x64-windows-static-md-release",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg/ports",
        "CFD_ENABLE_MPI": "ON"
      }
    },
    {
      "name": "windows-msvc-gui-release",
      "displayName": "Windows MSVC Release + GUI",
      "inherits": "windows-base",
      "cacheVariables": {
        "CFD_BUILD_GUI": "ON",
        "VCPKG_MANIFEST_FEATURES": "gui;mpi",
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md-release",
        "VCPKG_HOST_TRIPLET": "x64-windows-static-md-release",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg/ports",
        "CFD_ENABLE_MPI": "ON"
      }
    },
    {
      "name": "linux-system-gui",
      "displayName": "Linux system packages + GUI + MPI (no vcpkg)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++",
        "CFD_BUILD_GUI": "ON",
        "CFD_ENABLE_MPI": "ON"
      }
    },
    {
      "name": "windows-msvc-gui-cuda-release",
      "displayName": "Windows MSVC Release + GUI + CUDA solvers",
      "inherits": "windows-msvc-gui-release",
      "cacheVariables": {
        "CFD_GPU_BACKEND": "cuda",
        "CMAKE_CUDA_ARCHITECTURES": "native"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release"
    },
    {
      "name": "windows-msvc-mpi-release",
      "configurePreset": "windows-msvc-mpi-release"
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug"
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc-release"
    },
    {
      "name": "windows-msvc-gui-dev",
      "configurePreset": "windows-msvc-gui-dev"
    },
    {
      "name": "windows-msvc-gui-release",
      "configurePreset": "windows-msvc-gui-release"
    },
    {
      "name": "linux-system-gui",
      "configurePreset": "linux-system-gui"
    },
    {
      "name": "windows-msvc-gui-cuda-release",
      "configurePreset": "windows-msvc-gui-cuda-release"
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-debug",
      "inherits": "test-base",
      "configurePreset": "windows-msvc-debug"
    },
    {
      "name": "windows-msvc-release",
      "inherits": "test-base",
      "configurePreset": "windows-msvc-release"
    },
    {
      "name": "windows-msvc-mpi-release",
      "inherits": "test-base",
      "configurePreset": "windows-msvc-mpi-release"
    },
    {
      "name": "linux-gcc-debug",
      "inherits": "test-base",
      "configurePreset": "linux-gcc-debug"
    },
    {
      "name": "linux-gcc-release",
      "inherits": "test-base",
      "configurePreset": "linux-gcc-release"
    },
    {
      "name": "windows-msvc-gui-dev",
      "configurePreset": "windows-msvc-gui-dev",
      "inherits": "test-base"
    },
    {
      "name": "windows-msvc-gui-release",
      "configurePreset": "windows-msvc-gui-release",
      "inherits": "test-base"
    },
    {
      "name": "linux-system-gui",
      "configurePreset": "linux-system-gui",
      "inherits": "test-base"
    },
    {
      "name": "windows-msvc-gui-cuda-release",
      "configurePreset": "windows-msvc-gui-cuda-release",
      "inherits": "test-base"
    }
  ]
}
